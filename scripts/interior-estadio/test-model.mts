import assert from 'node:assert/strict'
import * as T from 'three'
import {criarTorcidaComplexo} from '../../src/escalacao/presidencia-complexo-torcida'
import {criarBolaFutebol3D,posicionarBolaFutebol3D,RAIO_BOLA_FUTEBOL_3D,ESCALA_BOLA_MAXIMA} from '../../src/escalacao/presidencia-bola-3d'
import {criarRedeGol3D,atualizarRedesGol3D,inspecionarRedesGol3D} from '../../src/escalacao/presidencia-rede-gol-3d'
const scene=new T.Scene(),seats=Array.from({length:8000},(_,i)=>({id:'seat-'+i,sector:'cadeiras',tier:'lower',row:Math.floor(i/80),column:i%80,seatHeight:.43,heading:i<4000?0:Math.PI,position:{x:(i%80-40)*1.1,y:Math.floor(i/80)%50*.2,z:i<4000?-50-Math.floor(i/80)*.3:50+(Math.floor(i/80)-50)*.3},supporterSide:i<4000?'home':'away'})) as any
const population={mode:'qa-sample',homeOccupancy:1,awayOccupancy:1,homeColor:'#1b7a3d',awayColor:'#c2452f'} as const,original=JSON.stringify(population)
const crowd=criarTorcidaComplexo(scene,seats,population,{detailedDistance:80,detailLimit:40,pixelDistance:240});crowd.perto({x:0,y:8,z:-51},true,{height:100000,fov:40});const allDistantBodies=crowd.inspect().triangles;crowd.perto({x:0,y:8,z:-51},true,{height:480,fov:40});const seated=crowd.inspect();assert(seated.lod.pixel>2000);assert(seated.lod.near<=40);assert(seated.triangles<allDistantBodies*.7,'Far stands retain occupancy without full distant bodies');
const occupied=()=>scene.children.flatMap(g=>g.children.flatMap((o:any)=>o.userData.seatIds??[]));const ids=new Set(occupied());assert.equal(ids.size,seated.presentation.drawn);const locations=new Map<string,number[]>();scene.children[0].children.forEach((m:any)=>{if(m.userData.part!=='shirt')return;const matrix=new T.Matrix4();m.userData.seatIds.forEach((id:string,i:number)=>{m.getMatrixAt(i,matrix);locations.set(id,new T.Vector3().setFromMatrixPosition(matrix).toArray())})});crowd.setMatchView(true);const tv=crowd.inspect();assert(tv.triangles<seated.triangles);assert.equal(tv.presentation.drawn,seated.presentation.drawn);assert.deepEqual(new Set(occupied()),ids);for(const mesh of scene.children[0].children as any[]){if(mesh.userData.part!=='shirt')continue;const matrix=new T.Matrix4();mesh.userData.seatIds.forEach((id:string,i:number)=>{mesh.getMatrixAt(i,matrix);assert.deepEqual(new T.Vector3().setFromMatrixPosition(matrix).toArray(),locations.get(id))})}const reserved=ids.values().next().value!;crowd.reserve([reserved]);assert(!occupied().includes(reserved));assert.equal(JSON.stringify(population),original);crowd.dispose();assert.equal(scene.children.length,0)
const ball=criarBolaFutebol3D();assert.equal(RAIO_BOLA_FUTEBOL_3D,.11);assert.equal(ESCALA_BOLA_MAXIMA,2.2);assert(ball.geometry.index!.count/3<=1500);posicionarBolaFutebol3D(ball,{time:0,ball:{x:3,y:.11,z:4}});const contact=ball.getObjectByName('ball-ground-contact') as T.Mesh<T.PlaneGeometry,T.MeshBasicMaterial>,groundOpacity=contact.material.opacity;posicionarBolaFutebol3D(ball,{time:1,ball:{x:3,y:4,z:4}});assert.deepEqual(ball.position.toArray(),[3,4,4]);assert(contact.scale.x>1);assert(contact.material.opacity<groundOpacity)
const goals=new T.Group();criarRedeGol3D(goals,-1);criarRedeGol3D(goals,1);atualizarRedesGol3D(goals,{time:.2,ball:{netImpact:{sign:1,y:1,z:0,time:0,strength:1} as any}});assert(inspecionarRedesGol3D(goals).some(n=>n.maximumDisplacement>0));atualizarRedesGol3D(goals,{time:3,ball:{}});assert(inspecionarRedesGol3D(goals).every(n=>n.maximumDisplacement===0));
console.log(JSON.stringify({crowd:{seated:seated.triangles,allDistantBodies,tv:tv.triangles,lod:seated.lod,occupied:ids.size},ownershipAndPositionsPreserved:true,ballRadius:.11,netReset:true}))
